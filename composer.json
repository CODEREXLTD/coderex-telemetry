{
    "name": "linno/telemetry",
    "description": "Privacy-first telemetry SDK for Linno WordPress plugins",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Linno",
            "email": "support@linno.co"
        }
    ],
    "require": {
        "php": ">=7.4",
        "posthog/posthog-php": "^2.1",
        "cweagans/composer-patches": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "LinnoSDK\\Telemetry\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LinnoSDK\\Telemetry\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "patches": {
            "posthog/posthog-php": {
                "Fix PHP 8.2+ deprecated string interpolation": "patches/posthog-php-php82.patch"
            }
        }
    }
}